# Google Places API key — server-side only, never sent to the browser
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# The Place ID of the business whose reviews you want to display
# Find it at: https://developers.google.com/maps/documentation/javascript/examples/places-placeid-finder
GOOGLE_PLACE_ID=ChIJN1t_tDeuEmsRUsoyG83frY4

# Minimum star rating to display (1–5). Defaults to 4 if not set.
MIN_STAR_RATING=4
